# Mailcow Configuration
MAILCOW_URL=http://mailcow:8080
MAILCOW_API_KEY=your_mailcow_api_key_here

# Redis Configuration
REDIS_URL=redis://redis:6379

# Security & JWT
SECRET_KEY=your_super_secret_key_change_this_in_production
DEBUG=False

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:4301

# Database
# SQLite (default):
DATABASE_PATH=mailcow.db
# PostgreSQL (optional): postgresql://user:pass@host:5432/mailcow
DATABASE_URL=

# Source IMAP Configuration
SOURCE_IMAP_HOST=imap.gmail.com
SOURCE_IMAP_PORT=993

# Job lock lifetime in seconds (default 12h). A very large migration can run
# longer than this; imapsync is idempotent so a re-pickup is safe.
JOB_LOCK_TIMEOUT=43200

# Notifications - job completion/failure (both optional)
# Generic webhook (POSTed JSON {event, job_id, message, summary}):
NOTIFY_WEBHOOK_URL=
# SMTP email notification:
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# API Version
API_VERSION=v1
